{
  "project": {
    "name": "replace-with-project-name",
    "summary": "replace-with-one-paragraph-product-summary",
    "language": "replace-with-language",
    "runtime": "replace-with-runtime-or-toolchain",
    "framework": "replace-with-framework-or-none",
    "ide": "replace-with-editor-or-ide",
    "repository_root": "."
  },
  "requirements": {
    "source_docs": [
      "AGENT.md",
      "docs/requirements.md",
      "docs/requirements_raw_links.md"
    ],
    "success_criteria": [
      "replace-with-main-deliverable",
      "replace-with-test-gate",
      "replace-with-performance-or-ux-goal"
    ]
  },
  "commands": {
    "build": "replace-with-build-command",
    "unit": "replace-with-unit-test-command",
    "integration": "replace-with-integration-test-command",
    "benchmark_smoke": "replace-with-benchmark-smoke-command",
    "release": "replace-with-release-command",
    "full_cycle": "powershell -ExecutionPolicy Bypass -File harness/scripts/run_harness_cycle.ps1"
  },
  "owners": {
    "agent-runtime": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "src/runtime/AGENT.md"
      ],
      "work_area": "src/runtime",
      "validation": "replace-with-runtime-validation-command",
      "failure_scope": [
        "main entry",
        "cli",
        "bootstrap"
      ]
    },
    "agent-query": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "src/query/AGENT.md"
      ],
      "work_area": "src/query",
      "validation": "replace-with-query-validation-command",
      "failure_scope": [
        "parser",
        "request handling",
        "execution orchestration"
      ]
    },
    "agent-storage": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "src/storage/AGENT.md"
      ],
      "work_area": "src/storage",
      "validation": "replace-with-storage-validation-command",
      "failure_scope": [
        "persistence",
        "schema",
        "io"
      ]
    },
    "agent-index": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "src/index/AGENT.md"
      ],
      "work_area": "src/index",
      "validation": "replace-with-index-validation-command",
      "failure_scope": [
        "indexing",
        "cache",
        "in-memory context"
      ]
    },
    "agent-tests": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "tests/AGENT.md"
      ],
      "work_area": "tests",
      "validation": "replace-with-tests-validation-command",
      "failure_scope": [
        "unit tests",
        "integration tests",
        "fixtures"
      ]
    },
    "manager-main": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "harness/project/prompts/manager_main.md",
        "harness/configs/git_policy.md"
      ],
      "work_area": "project-wide",
      "validation": "replace-with-main-manager-validation-command",
      "failure_scope": [
        "cross-module",
        "interface",
        "integration ownership"
      ]
    },
    "manager-harness": {
      "read": [
        "AGENT.md",
        "docs/requirements.md",
        "harness/AGENT.md",
        "harness/project/prompts/manager_harness.md",
        "harness/configs/git_policy.md"
      ],
      "work_area": "harness",
      "validation": "powershell -ExecutionPolicy Bypass -File harness/scripts/run_harness_cycle.ps1 -SkipRetryPrompt",
      "failure_scope": [
        "tooling",
        "dispatch",
        "automation"
      ]
    }
  },
  "dispatch": {
    "compile_owner": "manager-main",
    "interface_owner": "manager-main",
    "environment_owner": "manager-harness",
    "default_failure_type": "logic",
    "repeat_failure_escalation_owner": "manager-main"
  },
  "failure_patterns": {
    "environment": [
      "command not found",
      "not recognized",
      "No such file",
      "No such file or directory",
      "cannot find the path specified",
      "Cannot find module",
      "ERR_MODULE_NOT_FOUND",
      "ModuleNotFoundError",
      "ImportError",
      "package not found",
      "No module named",
      "no make-compatible command found",
      "Access is denied",
      "Permission denied",
      "UnauthorizedAccessException",
      "EPERM",
      "EACCES",
      "ECONNREFUSED",
      "ETIMEDOUT",
      "ENOTFOUND",
      "network timeout",
      "Temporary failure in name resolution"
    ],
    "compile": [
      "error:",
      "undefined reference",
      "fatal error",
      "compilation failed",
      "SyntaxError",
      "TypeScript error",
      "TS2307",
      "TS2322",
      "error[E",
      "cannot find symbol",
      "Compilation failure",
      "CS",
      "go build",
      "build failed"
    ],
    "interface": [
      "mismatch",
      "incompatible",
      "conflict",
      "expected",
      "actual",
      "AssertionError",
      "TypeError",
      "ReferenceError",
      "undefined method",
      "NoMethodError",
      "AttributeError",
      "contract",
      "schema validation"
    ]
  },
  "git_workflow": {
    "hooks_path": ".githooks",
    "state_file": "harness/state/git_workflow/state.json",
    "reports_dir": "harness/reports/git_workflow",
    "bootstrap_branch": "main",
    "main_branch": "main",
    "dev_branch": "dev",
    "feature_branch_prefix": "codex/",
    "test_branch_prefix": "codex/test/"
  },
  "harness": {
    "logs": "harness/reports/logs",
    "latest_report": "harness/reports/latest_report.md",
    "preflight_report": "harness/reports/preflight_report.md",
    "test_results": "harness/reports/test_results",
    "retry_prompts": "harness/reports/retry_prompts",
    "dispatch_packets": "harness/reports/dispatch_packets",
    "agent_runs": "harness/reports/agent_runs",
    "assignments_root": "harness/assignments",
    "dispatch_log": "harness/reports/dispatch_log.md",
    "assignment_log": "harness/reports/assignment_log.md",
    "live_dispatch_log": "harness/reports/live_dispatch_log.md"
  }
}
