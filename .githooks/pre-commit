#!/bin/sh
set -e
workspace_root="$(git rev-parse --show-toplevel)"
harness_root="$CODEX_HARNESS_ROOT"
if [ -z "$harness_root" ]; then
  harness_root="$workspace_root"
fi

script_path="$harness_root/scripts/assert_git_action_allowed.ps1"
if [ ! -f "$script_path" ]; then
  script_path="$harness_root/harness/scripts/assert_git_action_allowed.ps1"
fi

to_windows_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$1"
  elif command -v wslpath >/dev/null 2>&1; then
    wslpath -w "$1"
  else
    printf '%s\n' "$1"
  fi
}

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(to_windows_path "$script_path")" -Action commit -RepositoryRoot "$(to_windows_path "$workspace_root")"
